rules_version = '2';

// Locks the watchlist Firestore database to signed-in requests only.
// This blocks anyone who found the API key (e.g. on GitHub) from reading
// or writing your data directly via the Firestore REST/SDK API.
// Deploy: paste into Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /watchlist/{docId} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
